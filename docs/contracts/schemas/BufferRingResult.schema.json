{
  "$defs": {
    "BufferRing": {
      "additionalProperties": false,
      "description": "A core's settling ring: where captured tracers circle, and how full it is.",
      "properties": {
        "core_x": {
          "description": "Core x.",
          "title": "Core X",
          "type": "number"
        },
        "core_y": {
          "description": "Core y.",
          "title": "Core Y",
          "type": "number"
        },
        "index": {
          "description": "Ring index (matches basins values).",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "nearest_node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Closest node to the core.",
          "title": "Nearest Node Id"
        },
        "occupancy": {
          "description": "Tracers captured at the final step.",
          "minimum": 0,
          "title": "Occupancy",
          "type": "integer"
        },
        "radius": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Median settling distance of captured tracers.",
          "title": "Radius"
        },
        "share": {
          "description": "occupancy / tracers.",
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        },
        "spiral": {
          "description": "Spiral sink (oscillatory approach) vs node sink.",
          "title": "Spiral",
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "core_x",
        "core_y",
        "spiral",
        "occupancy",
        "share"
      ],
      "title": "BufferRing",
      "type": "object"
    },
    "FieldGrid": {
      "additionalProperties": false,
      "description": "Square sampling grid on [-extent, extent]^2. Row 0 is y = +extent (image order).",
      "properties": {
        "extent": {
          "default": 2.0,
          "description": "Half-width of the grid in model units.",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Extent",
          "type": "number"
        },
        "size": {
          "default": 32,
          "description": "Cells per side (G).",
          "maximum": 256,
          "minimum": 8,
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "FieldGrid",
      "type": "object"
    },
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of BufferRingPort.simulate().",
  "properties": {
    "basins": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to the G x G basin map."
    },
    "frame_id": {
      "description": "Frame identity, pinned to its labeling round (e.g. synthetic-example).",
      "pattern": "^[A-Za-z0-9._:-]{1,120}$",
      "title": "Frame Id",
      "type": "string"
    },
    "grid": {
      "$ref": "#/$defs/FieldGrid",
      "description": "Tracer seeding grid (also the basins grid)."
    },
    "history_filled": {
      "description": "How many history slots hold real records (<= T).",
      "minimum": 0,
      "title": "History Filled",
      "type": "integer"
    },
    "history_len": {
      "description": "T: ring-buffer length of occupancy history.",
      "minimum": 1,
      "title": "History Len",
      "type": "integer"
    },
    "inflow": {
      "description": "Inflow the tracers were advected at.",
      "title": "Inflow",
      "type": "number"
    },
    "occupancy_history": {
      "anyOf": [
        {
          "$ref": "#/$defs/TensorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None when there are no rings."
    },
    "request_digest": {
      "description": "SHA-256 of the request that produced this result.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "result_kind": {
      "const": "embedding_geometry",
      "default": "embedding_geometry",
      "description": "Always embedding_geometry: a demonstration over embedded records, not an operational forecast.",
      "title": "Result Kind",
      "type": "string"
    },
    "rings": {
      "description": "One ring per core found at this inflow.",
      "items": {
        "$ref": "#/$defs/BufferRing"
      },
      "title": "Rings",
      "type": "array"
    },
    "schema_version": {
      "const": "datamesh-sim/v2",
      "default": "datamesh-sim/v2",
      "description": "Contract version; bump on any breaking change.",
      "title": "Schema Version",
      "type": "string"
    },
    "tracers": {
      "description": "P = G*G tracers, one per grid cell.",
      "minimum": 1,
      "title": "Tracers",
      "type": "integer"
    },
    "tracers_final": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to final tracer positions."
    },
    "unassigned_share": {
      "description": "Share of tracers not captured by any ring.",
      "maximum": 1,
      "minimum": 0,
      "title": "Unassigned Share",
      "type": "number"
    }
  },
  "required": [
    "frame_id",
    "request_digest",
    "inflow",
    "grid",
    "tracers",
    "history_len",
    "history_filled",
    "rings",
    "unassigned_share",
    "basins",
    "tracers_final"
  ],
  "title": "BufferRingResult",
  "type": "object"
}
