{
  "$defs": {
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Multiscale transported readings and local perturbation response, with missingness and graph changes explicit.",
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x S x 6 readings."
    },
    "edge_jaccard": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x H graph stability diagnostic."
    },
    "embeddings_sha256": {
      "description": "Input embedding digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Embeddings Sha256",
      "type": "string"
    },
    "epsilon": {
      "description": "H: local perturbation amplitudes.",
      "items": {
        "type": "number"
      },
      "title": "Epsilon",
      "type": "array"
    },
    "feature_names": {
      "default": [
        "transport_alignment",
        "transport_coherence",
        "transport_phase_abs",
        "mean_path_length",
        "curvature_load",
        "defect_load"
      ],
      "description": "Last axis of descriptor and response_rms.",
      "items": {
        "type": "string"
      },
      "title": "Feature Names",
      "type": "array"
    },
    "focal_ids": {
      "description": "P: focal row order.",
      "items": {
        "pattern": "^[A-Za-z0-9._:-]{1,120}$",
        "type": "string"
      },
      "title": "Focal Ids",
      "type": "array"
    },
    "invariant_battery_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "True if base gauge battery passed, None if explicitly disabled.",
      "title": "Invariant Battery Passed"
    },
    "neighbor_count": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x S neighbor counts."
    },
    "radii": {
      "description": "S: radii used.",
      "items": {
        "type": "number"
      },
      "title": "Radii",
      "type": "array"
    },
    "request_digest": {
      "description": "Digest of complete probe request.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "response_rms": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x H x S x 6 sensitivity readings."
    },
    "response_valid": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x H x S joint-validity mask."
    },
    "result_kind": {
      "const": "embedding_geometry",
      "default": "embedding_geometry",
      "description": "Research readout, never an operational forecast or recovered semantic truth.",
      "title": "Result Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "datamesh-geodesic/v1",
      "default": "datamesh-geodesic/v1",
      "description": "Probe contract version.",
      "title": "Schema Version",
      "type": "string"
    },
    "valid": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x S mask."
    },
    "valid_fraction": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to P x H x S valid-perturbation fraction."
    }
  },
  "required": [
    "request_digest",
    "embeddings_sha256",
    "focal_ids",
    "radii",
    "epsilon",
    "invariant_battery_passed",
    "descriptor",
    "valid",
    "neighbor_count",
    "response_rms",
    "response_valid",
    "edge_jaccard",
    "valid_fraction"
  ],
  "title": "GeodesicProbeResult",
  "type": "object"
}
