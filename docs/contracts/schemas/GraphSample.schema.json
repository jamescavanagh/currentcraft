{
  "$defs": {
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of GraphTensorPort.build(): PyTorch Geometric conventions, held as refs.",
  "properties": {
    "edge_attr": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to edge features."
    },
    "edge_feature_names": {
      "default": [
        "coupling",
        "abs_coupling",
        "distance",
        "same_sign"
      ],
      "description": "Column order of edge_attr (D names).",
      "items": {
        "type": "string"
      },
      "title": "Edge Feature Names",
      "type": "array"
    },
    "edge_index": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to COO edges."
    },
    "edge_rule": {
      "description": "How edges were chosen.",
      "enum": [
        "knn",
        "coupling"
      ],
      "title": "Edge Rule",
      "type": "string"
    },
    "frame_id": {
      "description": "Frame identity, pinned to its labeling round (e.g. synthetic-example).",
      "pattern": "^[A-Za-z0-9._:-]{1,120}$",
      "title": "Frame Id",
      "type": "string"
    },
    "inflow": {
      "description": "Inflow the features describe.",
      "title": "Inflow",
      "type": "number"
    },
    "node_feature_names": {
      "default": [
        "x",
        "y",
        "strength",
        "abs_strength",
        "sign",
        "role_resource",
        "role_process",
        "role_operand",
        "role_unassigned",
        "speed",
        "divergence",
        "nearest_saddle_distance",
        "basin_share"
      ],
      "description": "Column order of x (F names).",
      "items": {
        "type": "string"
      },
      "title": "Node Feature Names",
      "type": "array"
    },
    "node_ids": {
      "description": "Node order for x rows and edge indices.",
      "items": {
        "pattern": "^[A-Za-z0-9._:-]{1,120}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Node Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "datamesh-sim/v2",
      "default": "datamesh-sim/v2",
      "description": "Contract version; bump on any breaking change.",
      "title": "Schema Version",
      "type": "string"
    },
    "x": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to node features."
    }
  },
  "required": [
    "frame_id",
    "inflow",
    "edge_rule",
    "node_ids",
    "x",
    "edge_index",
    "edge_attr"
  ],
  "title": "GraphSample",
  "type": "object"
}
