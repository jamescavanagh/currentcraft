{
  "$defs": {
    "EmbeddingRecord": {
      "additionalProperties": false,
      "description": "Dense and/or sparse vector for one object in one space. Sparse indices are zero-based here.",
      "properties": {
        "dense": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dense values, length dim.",
          "title": "Dense"
        },
        "dense_mask": {
          "anyOf": [
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True where the value is known; length dim.",
          "title": "Dense Mask"
        },
        "object_id": {
          "description": "Object the vector describes.",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$",
          "title": "Object Id",
          "type": "string"
        },
        "recorded_at": {
          "description": "When recorded.",
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/EmbeddingSpace",
          "description": "Model identity."
        },
        "sparse_indices": {
          "default": [],
          "description": "Zero-based, strictly increasing.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Sparse Indices",
          "type": "array"
        },
        "sparse_values": {
          "default": [],
          "description": "Values for sparse_indices.",
          "items": {
            "type": "number"
          },
          "title": "Sparse Values",
          "type": "array"
        }
      },
      "required": [
        "object_id",
        "space",
        "recorded_at"
      ],
      "title": "EmbeddingRecord",
      "type": "object"
    },
    "EmbeddingSpace": {
      "additionalProperties": false,
      "description": "Model identity of a vector. Vectors from different spaces are never compared.",
      "properties": {
        "dim": {
          "description": "Dimension.",
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Dim",
          "type": "integer"
        },
        "model_name": {
          "description": "Embedding model name.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "description": "Model version.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Model Version",
          "type": "string"
        },
        "precision": {
          "default": "float32",
          "description": "Precision the model emits.",
          "enum": [
            "float32",
            "float64"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_version",
        "dim"
      ],
      "title": "EmbeddingSpace",
      "type": "object"
    },
    "PhaseAssignment": {
      "additionalProperties": false,
      "description": "The phase evidence of one object. Weights are shares over phase codes, summing to 1 when phased.",
      "properties": {
        "basis": {
          "description": "Rule and evidence that produced the assignment, or why none.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "object_id": {
          "description": "Object.",
          "pattern": "^[A-Za-z0-9._:-]{1,160}$",
          "title": "Object Id",
          "type": "string"
        },
        "state": {
          "description": "One phase, several phases, or none.",
          "enum": [
            "phased",
            "mixed",
            "unphased"
          ],
          "title": "State",
          "type": "string"
        },
        "weights": {
          "default": [],
          "description": "(phase_code, share) pairs, codes sorted.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "pattern": "^[A-Za-z0-9._-]{1,40}$",
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Weights",
          "type": "array"
        }
      },
      "required": [
        "object_id",
        "state",
        "basis"
      ],
      "title": "PhaseAssignment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One object in the splice space.",
  "properties": {
    "assignment": {
      "$ref": "#/$defs/PhaseAssignment",
      "description": "Phase evidence."
    },
    "bins_used": {
      "default": [],
      "description": "Phase bins carrying mass (0-based bin index).",
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Bins Used",
      "type": "array"
    },
    "content_sha256": {
      "description": "Raw content lineage.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "embedding": {
      "$ref": "#/$defs/EmbeddingRecord",
      "description": "Sparse vector, zero-based indices. Block 0 is phase-free; block 1+b is bin b."
    },
    "kind": {
      "description": "Object kind.",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$",
      "title": "Kind",
      "type": "string"
    },
    "object_id": {
      "description": "Object.",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "title": "Object Id",
      "type": "string"
    },
    "tokens": {
      "description": "Distinct content tokens hashed (words + slots).",
      "minimum": 0,
      "title": "Tokens",
      "type": "integer"
    }
  },
  "required": [
    "object_id",
    "kind",
    "content_sha256",
    "assignment",
    "tokens",
    "embedding"
  ],
  "title": "SpliceRecord",
  "type": "object"
}
