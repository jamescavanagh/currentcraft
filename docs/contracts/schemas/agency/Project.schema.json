    "Quantity": {
      "additionalProperties": false,
      "description": "Finite nonnegative Decimal and explicit unit; zero remains zero.",
      "properties": {
        "amount": {
          "description": "Wire format: exact finite nonnegative decimal string. Python also accepts Decimal/int; JSON numbers are rejected.",
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(?:(?:\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)|-(?:0+(?:\\.0*)?|\\.0+))(?:[eE][+-]?[0-9]+)?)$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/UnitRef"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open timezone-aware interval; seconds are not inferred from dates.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "UnitRef": {
      "additionalProperties": false,
      "description": "Versioned reference to a unit in an explicitly selected dictionary.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "dictionary_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Id",
          "type": "string"
        },
        "dictionary_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Version",
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "dictionary_id",
        "dictionary_version",
        "code",
        "dimension"
      ],
      "title": "UnitRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Project identity, separate from its source business number.",
  "properties": {
    "actual_window": {
      "$ref": "#/$defs/Fact_TimeWindow_"
    },
    "baseline_window": {
      "$ref": "#/$defs/Fact_TimeWindow_"
    },
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "estimated_effort": {
      "$ref": "#/$defs/Fact_Quantity_"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "project",
      "default": "project",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/Fact_Annotated_str__StringConstraints__"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "enterprise-v1.1",
      "default": "enterprise-v1.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entity_id"
  ],
  "title": "Project",
  "type": "object"
