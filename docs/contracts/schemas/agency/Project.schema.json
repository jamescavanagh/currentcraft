{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_Annotated_str__StringConstraints__": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "epistemic_status": {
                  "const": "unknown"
                },
                "missing_reason": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "value",
                "epistemic_status",
                "missing_reason"
              ]
            },
            {
              "properties": {
                "epistemic_status": {
                  "enum": [
                    "observed",
                    "inferred"
                  ]
                },
                "evidence_ids": {
                  "minItems": 1
                },
                "missing_reason": {
                  "type": "null"
                },
                "value": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "value",
                "epistemic_status",
                "evidence_ids"
              ]
            }
          ]
        }
      ],
      "properties": {
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "epistemic_status"
      ],
      "title": "Fact[Annotated[str, StringConstraints]]",
      "type": "object"
    },
