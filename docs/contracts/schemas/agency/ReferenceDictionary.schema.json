{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_TimeWindow_": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact[TimeWindow]",
      "type": "object"
    },
    "ProcessType": {
      "additionalProperties": false,
      "description": "A kind of process: what it does to objects, independent of any project instance.",
      "properties": {
        "approved": {
          "default": false,
          "description": "True only after a process SME signs off the classification; inferred classes stay False.",
          "title": "Approved",
          "type": "boolean"
        },
        "code": {
          "description": "Caller vocabulary process code, e.g. 'design' or a catalogue number.",
          "pattern": "^[A-Za-z0-9._:-]{1,120}$",
          "title": "Code",
          "type": "string"
        },
        "function_classes": {
          "description": "What the process does: transform, transport, hold, exchange, control.",
          "items": {
            "enum": [
              "transform",
              "transport",
              "hold",
              "exchange",
              "control"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Function Classes",
          "type": "array"
        },
        "name": {
          "description": "Human-readable process name.",
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "function_classes"
      ],
      "title": "ProcessType",
      "type": "object"
    },
    "QualityEvidence": {
      "additionalProperties": false,
      "description": "Source assertion and time provenance; never implicit human authority.",
      "properties": {
        "definition_status": {
          "const": "v1-proposal",
          "default": "v1-proposal",
          "title": "Definition Status",
          "type": "string"
        },
        "entity_id": {
          "description": "Required opaque internal identity.",
          "format": "uuid",
          "title": "Entity Id",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "external_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalReference"
          },
          "title": "External Refs",
          "type": "array"
        },
        "kind": {
          "const": "quality_evidence",
          "default": "quality_evidence",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Locator",
          "type": "string"
        },
        "record_version": {
          "default": 1,
          "minimum": 1,
          "title": "Record Version",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "schema_version": {
          "const": "enterprise-v1",
          "default": "enterprise-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_sha256_missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "not supplied",
          "title": "Source Sha256 Missing Reason"
        },
        "source_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "valid_time": {
          "$ref": "#/$defs/Fact_TimeWindow_"
        }
      },
      "required": [
        "entity_id",
        "source",
        "source_version",
        "locator",
        "status",
        "recorded_at"
      ],
      "title": "QualityEvidence",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open timezone-aware interval; seconds are not inferred from dates.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "UnitRef": {
      "additionalProperties": false,
      "description": "Versioned reference to a unit in an explicitly selected dictionary.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "dictionary_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Id",
          "type": "string"
        },
        "dictionary_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Version",
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "dictionary_id",
        "dictionary_version",
        "code",
        "dimension"
      ],
      "title": "UnitRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned declarative data, with no class names or executable expressions.",
  "properties": {
    "dictionary_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Dictionary Id",
      "type": "string"
    },
    "payload_sha256": {
      "description": "SHA-256 of canonical JSON units, stages, process_types.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Sha256",
      "type": "string"
    },
    "process_types": {
      "items": {
        "$ref": "#/$defs/ProcessType"
      },
      "title": "Process Types",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/QualityEvidence"
    },
    "schema_version": {
      "const": "enterprise-reference-v1",
      "default": "enterprise-reference-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Stages",
      "type": "array"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitRef"
      },
      "title": "Units",
      "type": "array"
    },
    "valid_window": {
      "$ref": "#/$defs/TimeWindow"
    },
    "version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "dictionary_id",
    "version",
    "synthetic",
    "valid_window",
    "provenance",
    "units",
    "stages",
    "process_types",
    "payload_sha256"
  ],
  "title": "ReferenceDictionary",
  "type": "object"
}
