{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_Annotated_str__StringConstraints__": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "missing_reason": {
                "type": "null"
              }
            },
            "required": [
              "evidence_ids"
            ]
          },
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        }
      ],
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact[Annotated[str, StringConstraints]]",
      "type": "object"
    },
    "Fact_TimeWindow_": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "missing_reason": {
                "type": "null"
              }
            },
            "required": [
              "evidence_ids"
            ]
          },
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        }
      ],
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact[TimeWindow]",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open timezone-aware interval; seconds are not inferred from dates.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Project lifecycle phase; not a simulator phase or execution stage.",
  "properties": {
    "actual_window": {
      "$ref": "#/$defs/Fact_TimeWindow_"
    },
    "baseline_window": {
      "$ref": "#/$defs/Fact_TimeWindow_"
    },
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "phase",
      "default": "phase",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/Fact_Annotated_str__StringConstraints__"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "enterprise-v1",
      "default": "enterprise-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "project_id"
  ],
  "title": "Phase",
  "type": "object"
}
