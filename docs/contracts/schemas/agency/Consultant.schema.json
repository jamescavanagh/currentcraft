{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_Annotated_str__StringConstraints__": {
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "epistemic_status": {
                  "const": "unknown"
                },
                "missing_reason": {
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "value": {
                  "type": "null"
                }
              },
              "required": [
                "value",
                "epistemic_status",
                "missing_reason"
              ]
            },
            {
              "properties": {
                "epistemic_status": {
                  "enum": [
                    "observed",
                    "inferred"
                  ]
                },
                "evidence_ids": {
                  "minItems": 1
                },
                "missing_reason": {
                  "type": "null"
                },
                "value": {
                  "not": {
                    "type": "null"
                  }
                }
              },
              "required": [
                "value",
                "epistemic_status",
                "evidence_ids"
              ]
            }
          ]
        }
      ],
      "properties": {
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array",
          "uniqueItems": true
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "epistemic_status"
      ],
      "title": "Fact[Annotated[str, StringConstraints]]",
      "type": "object"
    },
    "ProjectContext": {
      "additionalProperties": false,
      "description": "Project-scoped relationship context; no authority implied.",
      "properties": {
        "kind": {
          "const": "project",
          "default": "project",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectContext",
      "type": "object"
    },
    "SubsystemContext": {
      "additionalProperties": false,
      "description": "Subsystem within an explicitly asserted project, checked at the application boundary.",
      "properties": {
        "kind": {
          "const": "subsystem",
          "default": "subsystem",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "subsystem_id": {
          "format": "uuid",
          "title": "Subsystem Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "subsystem_id"
      ],
      "title": "SubsystemContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Consulting engagement; approvals require explicit scoped human authority.",
  "properties": {
    "approval_claim_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Approval Claim Ids",
      "type": "array"
    },
    "context": {
      "discriminator": {
        "mapping": {
          "project": "#/$defs/ProjectContext",
          "subsystem": "#/$defs/SubsystemContext"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectContext"
        },
        {
          "$ref": "#/$defs/SubsystemContext"
        }
      ],
      "title": "Context"
    },
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "consultant",
      "default": "consultant",
      "title": "Kind",
      "type": "string"
    },
    "party_id": {
      "format": "uuid",
      "title": "Party Id",
      "type": "string"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "role": {
      "$ref": "#/$defs/Fact_Annotated_str__StringConstraints__"
    },
    "schema_version": {
      "const": "enterprise-v1.1",
      "default": "enterprise-v1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Fact_Annotated_str__StringConstraints__"
    }
  },
  "required": [
    "entity_id",
    "party_id",
    "context"
  ],
  "title": "Consultant",
  "type": "object"
}
