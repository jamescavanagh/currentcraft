{
  "$defs": {
    "PlateVortex": {
      "additionalProperties": false,
      "description": "A local vortex pinned in the plate frame. Strength is given explicitly, never inferred from projection handedness.",
      "properties": {
        "id": {
          "description": "Stable vortex id.",
          "pattern": "^[A-Za-z0-9._:-]{1,120}$",
          "title": "Id",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence for position and strength.",
          "title": "Source Ref"
        },
        "strength": {
          "description": "Circulation Gamma; sign is spin direction, not good or bad.",
          "maximum": 10,
          "minimum": -10,
          "title": "Strength",
          "type": "number"
        },
        "u": {
          "description": "Plate-frame x.",
          "maximum": 10,
          "minimum": -10,
          "title": "U",
          "type": "number"
        },
        "v": {
          "description": "Plate-frame y.",
          "maximum": 10,
          "minimum": -10,
          "title": "V",
          "type": "number"
        }
      },
      "required": [
        "id",
        "u",
        "v",
        "strength"
      ],
      "title": "PlateVortex",
      "type": "object"
    },
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sample the plate field (global spin + local vortices) and its analytic Jacobian at points.",
  "properties": {
    "core_radius": {
      "default": 0.09,
      "description": "Vortex core delta.",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Core Radius",
      "type": "number"
    },
    "frame": {
      "default": "plate",
      "description": "plate: vortices only; inertial: adds Omega J x and rotates by phase.",
      "enum": [
        "plate",
        "inertial"
      ],
      "title": "Frame",
      "type": "string"
    },
    "omega": {
      "default": 0.0,
      "description": "Global spin rate; must be 0 in the plate frame.",
      "title": "Omega",
      "type": "number"
    },
    "phase": {
      "default": 0.0,
      "description": "Plate phase; must be 0 in the plate frame.",
      "title": "Phase",
      "type": "number"
    },
    "points": {
      "$ref": "#/$defs/TensorRef",
      "description": "K x 2 POINTS_SPEC sample points in the requested frame."
    },
    "vortices": {
      "description": "Local vortices in the plate frame.",
      "items": {
        "$ref": "#/$defs/PlateVortex"
      },
      "title": "Vortices",
      "type": "array"
    }
  },
  "required": [
    "vortices",
    "points"
  ],
  "title": "PlateFieldRequest",
  "type": "object"
}
