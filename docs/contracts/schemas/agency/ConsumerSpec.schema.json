{
  "$defs": {
    "FrozenProjection": {
      "additionalProperties": false,
      "description": "PCA to 3D fit once on an explicit fit set. Applied, never refit.",
      "properties": {
        "components": {
          "$ref": "#/$defs/TensorRef",
          "description": "Ref to 3 x D components."
        },
        "digest": {
          "description": "SHA-256 of components, mean, fit ids, width and tokenizer.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "discarded_share": {
          "description": "Variance share in the projection-null space (reported, not hidden).",
          "maximum": 1,
          "minimum": 0,
          "title": "Discarded Share",
          "type": "number"
        },
        "explained_share": {
          "description": "Variance share kept by the 3 components.",
          "maximum": 1,
          "minimum": 0,
          "title": "Explained Share",
          "type": "number"
        },
        "fit_ids": {
          "description": "Object ids of the fit set.",
          "items": {
            "pattern": "^[A-Za-z0-9._:-]{1,160}$",
            "type": "string"
          },
          "minItems": 3,
          "title": "Fit Ids",
          "type": "array"
        },
        "mean": {
          "$ref": "#/$defs/TensorRef",
          "description": "Ref to D mean."
        },
        "name": {
          "description": "Projection name.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Name",
          "type": "string"
        },
        "text_dim": {
          "description": "Feature width it applies to.",
          "minimum": 16,
          "title": "Text Dim",
          "type": "integer"
        },
        "tokenizer": {
          "description": "Tokenizer and hashing version.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "name",
        "text_dim",
        "tokenizer",
        "fit_ids",
        "explained_share",
        "discarded_share",
        "digest",
        "components",
        "mean"
      ],
      "title": "FrozenProjection",
      "type": "object"
    },
    "TensorPlan": {
      "additionalProperties": false,
      "description": "What a consumer needs as tensors.",
      "properties": {
        "name": {
          "description": "Plan name.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Name",
          "type": "string"
        },
        "numeric_fields": {
          "default": [],
          "description": "Numeric fields, in column order.",
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Numeric Fields",
          "type": "array"
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrozenProjection"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Apply this frozen projection to produce positions."
        },
        "relation_types": {
          "default": [],
          "description": "Relation types kept as edges, in type-index order.",
          "items": {
            "pattern": "^[A-Za-z0-9._:-]{1,80}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Relation Types",
          "type": "array"
        },
        "text_dim": {
          "default": 512,
          "description": "Hashed text feature width D.",
          "maximum": 65536,
          "minimum": 16,
          "title": "Text Dim",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "TensorPlan",
      "type": "object"
    },
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A ring consumer (GNN, ensemble, enrichment, ...) and the tensor plan it needs.",
  "properties": {
    "batch_size": {
      "default": 256,
      "description": "Max entries per batch.",
      "maximum": 100000,
      "minimum": 1,
      "title": "Batch Size",
      "type": "integer"
    },
    "kinds": {
      "default": [],
      "description": "Object kinds read; empty reads all.",
      "items": {
        "pattern": "^[A-Za-z0-9._:-]{1,80}$",
        "type": "string"
      },
      "title": "Kinds",
      "type": "array"
    },
    "name": {
      "description": "Consumer name; owns a ring cursor.",
      "pattern": "^[A-Za-z0-9._:-]{1,80}$",
      "title": "Name",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/TensorPlan",
      "description": "Tensor plan."
    }
  },
  "required": [
    "name",
    "plan"
  ],
  "title": "ConsumerSpec",
  "type": "object"
}
