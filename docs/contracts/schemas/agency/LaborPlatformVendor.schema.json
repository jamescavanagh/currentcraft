{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Platform; separate from the party providing booked labor. No overlap/exclusivity policy is imposed.",
  "properties": {
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "labor_platform_vendor",
      "default": "labor_platform_vendor",
      "title": "Kind",
      "type": "string"
    },
    "party_id": {
      "format": "uuid",
      "title": "Party Id",
      "type": "string"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "enterprise-v1.1",
      "default": "enterprise-v1.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "party_id"
  ],
  "title": "LaborPlatformVendor",
  "type": "object"
}
