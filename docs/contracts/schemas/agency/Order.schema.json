{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_NewType_": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact[NewType]",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Commercial order identity, separate from supporting documents.",
  "properties": {
    "counterparty_id": {
      "$ref": "#/$defs/Fact_NewType_"
    },
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "document_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Document Ids",
      "type": "array"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "order",
      "default": "order",
      "title": "Kind",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "enterprise-v1",
      "default": "enterprise-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "entity_id",
    "project_id"
  ],
  "title": "Order",
  "type": "object"
}
