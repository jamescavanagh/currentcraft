{
  "$defs": {
    "ExternalReference": {
      "additionalProperties": false,
      "description": "Source namespace plus source key; neither becomes internal identity.",
      "properties": {
        "key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Key",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "key"
      ],
      "title": "ExternalReference",
      "type": "object"
    },
    "Fact_TimeWindow_": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "missing_reason": {
                "type": "null"
              }
            },
            "required": [
              "evidence_ids"
            ]
          },
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        }
      ],
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value"
      ],
      "title": "Fact[TimeWindow]",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "description": "Half-open timezone-aware interval; seconds are not inferred from dates.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "source_sha256_missing_reason": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "source_sha256": {
            "type": "null"
          }
        },
        "required": [
          "source_sha256"
        ]
      },
      "then": {
        "properties": {
          "source_sha256_missing_reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_sha256_missing_reason"
        ]
      }
    }
  ],
  "description": "Source assertion and time provenance; never implicit human authority.",
  "properties": {
    "definition_status": {
      "const": "v1-proposal",
      "default": "v1-proposal",
      "title": "Definition Status",
      "type": "string"
    },
    "entity_id": {
      "description": "Required opaque internal identity.",
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "external_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalReference"
      },
      "title": "External Refs",
      "type": "array"
    },
    "kind": {
      "const": "quality_evidence",
      "default": "quality_evidence",
      "title": "Kind",
      "type": "string"
    },
    "locator": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Locator",
      "type": "string"
    },
    "record_version": {
      "default": 1,
      "minimum": 1,
      "title": "Record Version",
      "type": "integer"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "enterprise-v1",
      "default": "enterprise-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source",
      "type": "string"
    },
    "source_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "source_sha256_missing_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "not supplied",
      "title": "Source Sha256 Missing Reason"
    },
    "source_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "valid_time": {
      "$ref": "#/$defs/Fact_TimeWindow_"
    }
  },
  "required": [
    "entity_id",
    "source",
    "source_version",
    "locator",
    "status",
    "recorded_at"
  ],
  "title": "QualityEvidence",
  "type": "object"
}
