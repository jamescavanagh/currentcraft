{
  "$defs": {
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Names one capability: a resource doing a process (an element of E_S).",
      "properties": {
        "process": {
          "description": "Translated process id, e.g. 'transform:build_rack@bench' or 'refined:hold(rack:built):bench->room201'.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Process",
          "type": "string"
        },
        "resource_id": {
          "description": "Executing resource.",
          "pattern": "^[A-Za-z0-9._:-]{1,120}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "process",
        "resource_id"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One K_S row: a capability that exists but is not available (PTO, region, oversize load, no authority).",
  "properties": {
    "capability": {
      "$ref": "#/$defs/CapabilityRef",
      "description": "The capability this constraint switches off."
    },
    "evidence_ref": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Where the constraint is evidenced.",
      "title": "Evidence Ref"
    },
    "reason": {
      "description": "Why it is unavailable.",
      "maxLength": 200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inclusive start; None = always.",
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exclusive end; None = open-ended.",
      "title": "Valid To"
    }
  },
  "required": [
    "capability",
    "reason"
  ],
  "title": "CapabilityConstraint",
  "type": "object"
}
