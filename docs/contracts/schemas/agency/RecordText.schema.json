      "description": "Optional body text.",
      "title": "Text"
    },
    "title": {
      "description": "Record title; CamelCase is split into words.",
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "RecordText",
  "type": "object"
