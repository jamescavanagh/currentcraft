{
  "$defs": {
    "EmbeddingSpace": {
      "additionalProperties": false,
      "description": "Model identity of a vector. Vectors from different spaces are never compared.",
      "properties": {
        "dim": {
          "description": "Dimension.",
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Dim",
          "type": "integer"
        },
        "model_name": {
          "description": "Embedding model name.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Model Name",
          "type": "string"
        },
        "model_version": {
          "description": "Model version.",
          "pattern": "^[A-Za-z0-9._:-]{1,80}$",
          "title": "Model Version",
          "type": "string"
        },
        "precision": {
          "default": "float32",
          "description": "Precision the model emits.",
          "enum": [
            "float32",
            "float64"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "model_version",
        "dim"
      ],
      "title": "EmbeddingSpace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Dense and/or sparse vector for one object in one space. Sparse indices are zero-based here.",
  "properties": {
    "dense": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dense values, length dim.",
      "title": "Dense"
    },
    "dense_mask": {
      "anyOf": [
        {
          "items": {
            "type": "boolean"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True where the value is known; length dim.",
      "title": "Dense Mask"
    },
    "object_id": {
      "description": "Object the vector describes.",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$",
      "title": "Object Id",
      "type": "string"
    },
    "recorded_at": {
      "description": "When recorded.",
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "space": {
      "$ref": "#/$defs/EmbeddingSpace",
      "description": "Model identity."
    },
    "sparse_indices": {
      "default": [],
      "description": "Zero-based, strictly increasing.",
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Sparse Indices",
      "type": "array"
    },
    "sparse_values": {
      "default": [],
      "description": "Values for sparse_indices.",
      "items": {
        "type": "number"
      },
      "title": "Sparse Values",
      "type": "array"
    }
  },
  "required": [
    "object_id",
    "space",
    "recorded_at"
  ],
  "title": "EmbeddingRecord",
  "type": "object"
}
