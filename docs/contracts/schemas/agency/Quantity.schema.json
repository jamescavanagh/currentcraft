{
  "$defs": {
    "UnitRef": {
      "additionalProperties": false,
      "description": "Versioned reference to a unit in an explicitly selected dictionary.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "dictionary_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Id",
          "type": "string"
        },
        "dictionary_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dictionary Version",
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "dictionary_id",
        "dictionary_version",
        "code",
        "dimension"
      ],
      "title": "UnitRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Finite nonnegative Decimal and explicit unit; zero remains zero.",
  "properties": {
    "amount": {
      "description": "Wire format: exact finite nonnegative decimal string. Python also accepts Decimal/int; JSON numbers are rejected.",
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(?:(?:\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)|-(?:0+(?:\\.0*)?|\\.0+))(?:[eE][+-]?[0-9]+)?)$",
      "title": "Amount",
      "type": "string"
    },
    "unit": {
      "$ref": "#/$defs/UnitRef"
    }
  },
  "required": [
    "amount",
    "unit"
  ],
  "title": "Quantity",
  "type": "object"
}
