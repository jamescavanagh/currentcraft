{
  "$defs": {
    "BracketState": {
      "additionalProperties": false,
      "description": "Where a coordinate sits in its bracket.",
      "properties": {
        "at_wall": {
          "description": "True when |e| has reached (1 - margin) k_b.",
          "title": "At Wall",
          "type": "boolean"
        },
        "barrier": {
          "description": "V = 0.5 ln(k_b^2 / (k_b^2 - e^2)); 0 at the centre, unbounded at the walls.",
          "minimum": 0,
          "title": "Barrier",
          "type": "number"
        },
        "error": {
          "description": "e = value - centre.",
          "title": "Error",
          "type": "number"
        },
        "fraction": {
          "description": "|e| / k_b.",
          "maximum": 1,
          "minimum": 0,
          "title": "Fraction",
          "type": "number"
        },
        "value": {
          "description": "Current coordinate.",
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "error",
        "barrier",
        "fraction",
        "at_wall"
      ],
      "title": "BracketState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of filtering one human move through the barrier.",
  "properties": {
    "applied_displacement": {
      "description": "Displacement actually applied over dt.",
      "title": "Applied Displacement",
      "type": "number"
    },
    "requested_velocity": {
      "description": "Human request v.",
      "title": "Requested Velocity",
      "type": "number"
    },
    "state": {
      "$ref": "#/$defs/BracketState",
      "description": "State after the move."
    },
    "substeps": {
      "description": "Splitting steps for the centring gain (1 without gain).",
      "minimum": 1,
      "title": "Substeps",
      "type": "integer"
    },
    "value": {
      "description": "New coordinate.",
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "value",
    "requested_velocity",
    "applied_displacement",
    "substeps",
    "state"
  ],
  "title": "BracketStep",
  "type": "object"
}
