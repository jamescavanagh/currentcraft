{
  "$defs": {
    "CollisionEvent": {
      "additionalProperties": false,
      "description": "Saddle-count change between two slices, refined by bisection.",
      "properties": {
        "inflow": {
          "description": "Refined inflow of the change.",
          "title": "Inflow",
          "type": "number"
        },
        "saddles_after": {
          "description": "Count just above.",
          "minimum": 0,
          "title": "Saddles After",
          "type": "integer"
        },
        "saddles_before": {
          "description": "Count just below.",
          "minimum": 0,
          "title": "Saddles Before",
          "type": "integer"
        }
      },
      "required": [
        "inflow",
        "saddles_before",
        "saddles_after"
      ],
      "title": "CollisionEvent",
      "type": "object"
    },
    "CriticalPoint": {
      "additionalProperties": false,
      "properties": {
        "det": {
          "description": "Jacobian determinant; < 0 is a saddle.",
          "title": "Det",
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/PointKind",
          "description": "Classification from the Jacobian."
        },
        "mu_min_abs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Smallest |eigenvalue| mu of the Jacobian (saddles only). Eigenvalues are mu so lambda only ever means inflow. Input still accepts the pre-0.9.8 key lambda_min_abs (deprecated alias); output is mu_min_abs.",
          "title": "Mu Min Abs"
        },
        "nearest_node_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]{1,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Closest node (attribution hint, not causation).",
          "title": "Nearest Node Id"
        },
        "trace": {
          "description": "Jacobian trace (divergence at the point).",
          "title": "Trace",
          "type": "number"
        },
        "x": {
          "description": "Point x.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Point y.",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "kind",
        "det",
        "trace"
      ],
      "title": "CriticalPoint",
      "type": "object"
    },
    "FieldGrid": {
      "additionalProperties": false,
      "description": "Square sampling grid on [-extent, extent]^2. Row 0 is y = +extent (image order).",
      "properties": {
        "extent": {
          "default": 2.0,
          "description": "Half-width of the grid in model units.",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Extent",
          "type": "number"
        },
        "size": {
          "default": 32,
          "description": "Cells per side (G).",
          "maximum": 256,
          "minimum": 8,
          "title": "Size",
          "type": "integer"
        }
      },
      "title": "FieldGrid",
      "type": "object"
    },
    "InflowSlice": {
      "additionalProperties": false,
      "properties": {
        "core_count": {
          "description": "Sinks or centres found.",
          "minimum": 0,
          "title": "Core Count",
          "type": "integer"
        },
        "inflow": {
          "description": "Inflow of this slice.",
          "title": "Inflow",
          "type": "number"
        },
        "points": {
          "default": [],
          "description": "All critical points, saddles first.",
          "items": {
            "$ref": "#/$defs/CriticalPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "saddle_count": {
          "description": "Saddles found.",
          "minimum": 0,
          "title": "Saddle Count",
          "type": "integer"
        }
      },
      "required": [
        "inflow",
        "saddle_count",
        "core_count"
      ],
      "title": "InflowSlice",
      "type": "object"
    },
    "PointKind": {
      "enum": [
        "saddle",
        "spiral_sink",
        "node_sink",
        "centre",
        "source"
      ],
      "title": "PointKind",
      "type": "string"
    },
    "TensorRef": {
      "additionalProperties": false,
      "description": "A validated handle to a tensor held by an infrastructure store. Carries no array data.",
      "properties": {
        "key": {
          "description": "Store key; resolve only through a TensorStorePort.",
          "pattern": "^[A-Za-z0-9._:/-]{1,200}$",
          "title": "Key",
          "type": "string"
        },
        "producer": {
          "description": "Adapter that produced the tensor.",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 over dtype, shape and C-order bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "shape": {
          "description": "Concrete shape of the stored array.",
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "spec": {
          "$ref": "#/$defs/TensorSpec",
          "description": "Contract spec the tensor satisfies."
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorStats"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary statistics recorded by the store."
        }
      },
      "required": [
        "spec",
        "key",
        "shape",
        "sha256",
        "producer"
      ],
      "title": "TensorRef",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "description": "What a tensor must look like. Symbols (``N``, ``S``) bind to sizes per contract instance.",
      "properties": {
        "description": {
          "description": "What the values mean.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dims": {
          "description": "Axis names, outermost first.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        },
        "dtype": {
          "description": "Element type; adapters must not silently cast.",
          "enum": [
            "float32",
            "float64",
            "int64",
            "int32",
            "int16",
            "int8",
            "uint8",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "finite": {
          "default": true,
          "description": "Floating values must be finite (no NaN or inf).",
          "title": "Finite",
          "type": "boolean"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layout tag such as SCHW, NF or COO.",
          "title": "Layout"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound on values, if any.",
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound on values, if any.",
          "title": "Min Value"
        },
        "name": {
          "description": "Stable tensor name used in docs, stores and keys.",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "title": "Name",
          "type": "string"
        },
        "shape": {
          "description": "Size per axis: a positive int or a symbol bound per contract.",
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical or model unit of the values, if any.",
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "dims",
        "shape",
        "dtype",
        "description"
      ],
      "title": "TensorSpec",
      "type": "object"
    },
    "TensorStats": {
      "additionalProperties": false,
      "description": "Cheap summary recorded by the store; lets docs, logs and APIs describe a tensor without its data.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum finite value.",
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean of finite values.",
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum finite value.",
          "title": "Min"
        },
        "nonfinite": {
          "default": 0,
          "description": "Count of NaN or inf values.",
          "minimum": 0,
          "title": "Nonfinite",
          "type": "integer"
        }
      },
      "title": "TensorStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of NodeInteractionPort.simulate().",
  "properties": {
    "coupling": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to the N x N coupling matrix."
    },
    "events": {
      "default": [],
      "description": "Saddle-count changes refined by bisection.",
      "items": {
        "$ref": "#/$defs/CollisionEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "field": {
      "anyOf": [
        {
          "$ref": "#/$defs/TensorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ref to the S x 5 x G x G field tensor, if a grid was requested."
    },
    "frame_id": {
      "description": "Frame identity, pinned to its labeling round (e.g. synthetic-example).",
      "pattern": "^[A-Za-z0-9._:-]{1,120}$",
      "title": "Frame Id",
      "type": "string"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldGrid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Field grid used, or None if no field was requested."
    },
    "n_nodes": {
      "description": "N: number of nodes simulated.",
      "minimum": 1,
      "title": "N Nodes",
      "type": "integer"
    },
    "node_velocity": {
      "$ref": "#/$defs/TensorRef",
      "description": "Ref to field velocity at each node per slice."
    },
    "request_digest": {
      "description": "SHA-256 of the request that produced this result.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "result_kind": {
      "const": "embedding_geometry",
      "default": "embedding_geometry",
      "description": "Always embedding_geometry: a demonstration over embedded records, not an operational forecast.",
      "title": "Result Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "datamesh-sim/v2",
      "default": "datamesh-sim/v2",
      "description": "Contract version; bump on any breaking change.",
      "title": "Schema Version",
      "type": "string"
    },
    "slices": {
      "description": "Critical points per inflow slice, increasing inflow.",
      "items": {
        "$ref": "#/$defs/InflowSlice"
      },
      "minItems": 1,
      "title": "Slices",
      "type": "array"
    }
  },
  "required": [
    "frame_id",
    "request_digest",
    "n_nodes",
    "grid",
    "slices",
    "coupling",
    "node_velocity"
  ],
  "title": "NodeInteractionResult",
  "type": "object"
}
