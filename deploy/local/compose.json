{
  "name": "datamesh-local",
  "services": {
    "postgres": {
      "image": "postgres:18",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "datamesh",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/pg_admin",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256"
      },
      "secrets": [
        "pg_admin",
        "pg_app"
      ],
      "volumes": [
        "postgres_data:/var/lib/postgresql",
        "./init_postgres.sh:/docker-entrypoint-initdb.d/10-datamesh.sh:ro"
      ],
      "ports": [
        "127.0.0.1:${CURRENTCRAFT_PG_PORT-${DATAMESH_PG_PORT:-5433}}:5432"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d datamesh"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 30
      }
    },
    "nats": {
      "image": "nats:2.11-alpine",
      "command": [
        "-c",
        "/run/secrets/nats_config"
      ],
      "restart": "unless-stopped",
      "secrets": [
        "nats_config"
      ],
      "volumes": [
        "nats_data:/data"
      ],
      "ports": [
        "127.0.0.1:${CURRENTCRAFT_NATS_PORT-${DATAMESH_NATS_PORT:-4222}}:4222"
      ],
      "user": "10001:10001",
      "depends_on": {
        "prepare": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "bootstrap": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": [
        "bootstrap"
      ],
      "secrets": [
        "pg_app",
        "nats_token",
        "pseudonym_salt"
      ],
      "volumes": [
        "blob_data:/srv/datamesh/blobs"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "nats": {
          "condition": "service_started"
        },
        "prepare": {
          "condition": "service_completed_successfully"
        }
      },
      "restart": "no"
    },
    "worker": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": [
        "worker"
      ],
      "init": true,
      "restart": "unless-stopped",
      "secrets": [
        "pg_app",
        "nats_token",
        "pseudonym_salt"
      ],
      "volumes": [
        "blob_data:/srv/datamesh/blobs",
        "../../references/private:/references/private:ro"
      ],
      "depends_on": {
        "bootstrap": {
          "condition": "service_completed_successfully"
        }
      },
      "stop_grace_period": "90s",
      "environment": {
        "CURRENTCRAFT_WORKBOOK_PROFILES": "${CURRENTCRAFT_WORKBOOK_PROFILES-${DATAMESH_WORKBOOK_PROFILES:-}}"
      }
    },
    "smoke": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": [
        "smoke"
      ],
      "profiles": [
        "tools"
      ],
      "secrets": [
        "pg_app",
        "nats_token",
        "pseudonym_salt"
      ],
      "volumes": [
        "blob_data:/srv/datamesh/blobs"
      ],
      "depends_on": {
        "bootstrap": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "publisher": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": [
        "publish"
      ],
      "profiles": [
        "tools"
      ],
      "secrets": [
        "nats_token"
      ],
      "volumes": [
        "blob_data:/srv/datamesh/blobs",
        "../../local/intake:/intake:ro"
      ],
      "environment": {
        "CURRENTCRAFT_INPUT_FILE": "${CURRENTCRAFT_INPUT_FILE-${DATAMESH_INPUT_FILE:-}}",
        "CURRENTCRAFT_INPUT_FORMAT": "${CURRENTCRAFT_INPUT_FORMAT-${DATAMESH_INPUT_FORMAT:-text}}",
        "CURRENTCRAFT_SOURCE_ID": "${CURRENTCRAFT_SOURCE_ID-${DATAMESH_SOURCE_ID:-}}",
        "CURRENTCRAFT_MAPPING": "${CURRENTCRAFT_MAPPING-${DATAMESH_MAPPING:-}}",
        "CURRENTCRAFT_BINDING_FILE": "${CURRENTCRAFT_BINDING_FILE-${DATAMESH_BINDING_FILE:-}}"
      },
      "depends_on": {
        "bootstrap": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "api-secrets": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": ["provision-api-secrets"],
      "profiles": ["tools"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "network_mode": "none",
      "volumes": ["api_secrets:/run/currentcraft-secrets"],
      "restart": "no"
    },
    "api": {
      "image": "datamesh-local-app:0.9.9",
      "user": "10001:10001",
      "command": ["api"],
      "init": true,
      "restart": "unless-stopped",
      "volumes": ["blob_data:/srv/datamesh/blobs", "api_secrets:/run/currentcraft-secrets:ro"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "environment": {
        "CURRENTCRAFT_PG_APP_FILE": "/run/currentcraft-secrets/pg_app",
        "CURRENTCRAFT_NATS_TOKEN_FILE": "/run/currentcraft-secrets/nats_token",
        "CURRENTCRAFT_API_TOKEN_FILE": "/run/currentcraft-secrets/api_token",
        "CURRENTCRAFT_PG_HOST": "postgres",
        "CURRENTCRAFT_PG_PORT": "5432",
        "CURRENTCRAFT_PG_DATABASE": "datamesh",
        "CURRENTCRAFT_PG_USER": "datamesh_app",
        "CURRENTCRAFT_NATS_SERVERS": "nats://nats:4222"
      },
      "ports": ["127.0.0.1:${CURRENTCRAFT_API_PORT-${DATAMESH_API_PORT:-8000}}:8000"],
      "depends_on": {
        "bootstrap": {"condition": "service_completed_successfully"}
      },
      "healthcheck": {
        "test": ["CMD", "python", "-c", "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=4); assert r.status == 200"],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "10s"
      }
    },
    "prepare": {
      "image": "datamesh-local-app:0.9.9",
      "build": {
        "context": "../..",
        "dockerfile": "deploy/local/Dockerfile"
      },
      "user": "0:0",
      "command": [
        "prepare"
      ],
      "volumes": [
        "blob_data:/srv/datamesh/blobs",
        "nats_data:/srv/datamesh/nats"
      ],
      "restart": "no"
    }
  },
  "secrets": {
    "pg_admin": {
      "file": "../../local/compose-secrets/pg_admin"
    },
    "pg_app": {
      "file": "../../local/compose-secrets/pg_app"
    },
    "nats_token": {
      "file": "../../local/compose-secrets/nats_token"
    },
    "nats_config": {
      "file": "../../local/compose-secrets/nats.conf"
    },
    "pseudonym_salt": {
      "file": "../../local/compose-secrets/pseudonym_salt"
    }
  },
  "volumes": {
    "api_secrets": {},
    "postgres_data": {},
    "nats_data": {},
    "blob_data": {}
  }
}
